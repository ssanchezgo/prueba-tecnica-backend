generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  transaction_id String   @db.Uuid
  merchant_id    String   @db.Uuid
  event_type     String
  payload        Json?
  status         String   @default("pending")
  attempts       Int      @default(0)
  created_at     DateTime @default(now())

  @@index([merchant_id])
  @@map("notifications")
}
